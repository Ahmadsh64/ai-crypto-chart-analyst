# =============================================================================
# AI Crypto Chart Analyst — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=false

# --- Backend ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1

# --- Frontend (Next.js public vars only — never put secrets here) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=AI Crypto Chart Analyst
# Supabase Auth public config (anon key is designed for browsers; still restrict via RLS/allowlist)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth (backend / Render only — never put private keys or JWT secrets in NEXT_PUBLIC_) ---
# Local/tests default: AUTH_ENABLED=false. Production personal beta: true.
# ES256: verified via SUPABASE_URL/.../jwks.json. Legacy HS256: verified via /auth/v1/user.
AUTH_ENABLED=false
SUPABASE_URL=
# Same anon/publishable key as the frontend public key (server-side Auth user lookup).
SUPABASE_ANON_KEY=
# Optional legacy field; not used for ES256 JWKS or remote HS256 verification.
SUPABASE_JWT_SECRET=
# Comma-separated owner emails allowed to call the API
AUTH_ALLOWED_EMAILS=
# OpenAPI: omit to auto-disable when ENVIRONMENT=production; set true/false to override
# DOCS_ENABLED=false

# --- Database / Supabase PostgreSQL (Phase 6.0.2) — NEVER expose to frontend ---
# Persistence is OFF by default. Set PERSISTENCE_ENABLED=true only when Supabase is ready.
PERSISTENCE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_crypto_chart
DATABASE_ECHO=false
# Optional Supabase connection (server-only). Prefer DATABASE_URL or SUPABASE_DB_URL.
# Example: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
# Official Supabase Root CA PEM (server-only). Relative paths resolve from backend/.
# Defaults to backend/prod-ca-2021.crt when that file exists.
SUPABASE_SSL_CA_FILE=prod-ca-2021.crt
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- OpenAI (Phase 5.4) — NEVER expose in frontend ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EXPLAINER_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1

# --- Exchange public endpoints (no trading keys required) ---
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BYBIT_BASE_URL=https://api.bybit.com

# --- Risk defaults ---
DEFAULT_ACCOUNT_BALANCE=10000
DEFAULT_RISK_PERCENT=1.0
DEFAULT_MIN_RISK_REWARD=2.0
MAX_RISK_PERCENT=5.0

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/jpg,image/webp
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MIN_IMAGE_WIDTH=64
MIN_IMAGE_HEIGHT=64
