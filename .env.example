# =============================================================================
# AI Crypto Chart Analyst — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=false

# --- Backend ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1

# --- Frontend (Next.js public vars only) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=AI Crypto Chart Analyst

# --- Database (Phase 6) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_crypto_chart
DATABASE_ECHO=false

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- OpenAI (Phase 5.4) — NEVER expose in frontend ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EXPLAINER_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1

# --- Exchange public endpoints (no trading keys required) ---
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BYBIT_BASE_URL=https://api.bybit.com

# --- Risk defaults ---
DEFAULT_ACCOUNT_BALANCE=10000
DEFAULT_RISK_PERCENT=1.0
DEFAULT_MIN_RISK_REWARD=2.0
MAX_RISK_PERCENT=5.0

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/jpg,image/webp
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MIN_IMAGE_WIDTH=64
MIN_IMAGE_HEIGHT=64
